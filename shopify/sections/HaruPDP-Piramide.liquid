{%- liquid
  assign mf = product.metafields.haru
  assign n_salida = mf.notas_salida.value | strip
  assign n_corazon = mf.notas_corazon.value | strip
  assign n_fondo = mf.notas_fondo.value | strip
  assign hay_notas = false
  if n_salida != blank or n_corazon != blank or n_fondo != blank
    assign hay_notas = true
  endif
-%}
{%- if hay_notas -%}
{%- style -%}
  #shopify-section-{{ section.id }} .haru-pdp-pir{
    --ancho-contenido: {{ section.settings.ancho_contenido }}px !important;
    --color-fondo: {{ section.settings.color_fondo }} !important;
    --color-texto: {{ section.settings.color_texto }} !important;
    --color-acento: {{ section.settings.color_acento }} !important;
    --color-parrafo: {{ section.settings.color_parrafo }} !important;
    --color-linea: color-mix(in srgb, {{ section.settings.color_texto }} 18%, transparent) !important;
    --tamano-titulo: {{ section.settings.tamano_titulo_movil }}px !important;
    --tamano-texto: {{ section.settings.tamano_texto_movil }}px !important;
    --tamano-nota: {{ section.settings.tamano_nota_movil }}px !important;
    --tamano-etiqueta: {{ section.settings.tamano_etiqueta_movil }}px !important;
    box-sizing: border-box !important;
    display: block !important;
    padding-top: {{ section.settings.padding_superior_movil }}px !important;
    padding-bottom: {{ section.settings.padding_inferior_movil }}px !important;
    background: var(--color-fondo) !important;
    color: var(--color-texto) !important;
    font-family: 'Hanken Grotesk', system-ui, sans-serif !important;
    font-size: var(--tamano-texto) !important;
    line-height: 1.6 !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir :where(h1,h2,h3,h4,h5,p,a,ul,ol,li,b,s,em,strong,span,small,summary,blockquote,figcaption){ color: inherit !important; font-family: inherit !important; }
  #shopify-section-{{ section.id }} .haru-pdp-pir *,
  #shopify-section-{{ section.id }} .haru-pdp-pir *::before,
  #shopify-section-{{ section.id }} .haru-pdp-pir *::after{
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__contenido{
    max-width: var(--ancho-contenido) !important;
    margin-inline: auto !important;
    padding-inline: 20px !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__etiqueta{
    margin: 0 !important;
    font-family: 'IBM Plex Mono', ui-monospace, monospace !important;
    font-size: var(--tamano-etiqueta) !important;
    line-height: 1.4 !important;
    letter-spacing: .16em !important;
    text-transform: uppercase !important;
    color: var(--color-acento) !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__titulo{
    margin: 12px 0 0 !important;
    padding: 0 !important;
    font-family: 'Instrument Serif', Georgia, serif !important;
    font-size: var(--tamano-titulo) !important;
    font-weight: 400 !important;
    line-height: 1 !important;
    letter-spacing: -.01em !important;
    text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__piramide{
    display: grid !important;
    gap: 12px !important;
    margin: 40px 0 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__fila{
    display: grid !important;
    gap: 16px !important;
    width: 100% !important;
    margin: 0 auto !important;
    padding: 24px 20px !important;
    border: 1px solid var(--color-linea) !important;
    list-style: none !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__nivel{
    margin: 0 !important;
    font-family: 'IBM Plex Mono', ui-monospace, monospace !important;
    font-size: var(--tamano-etiqueta) !important;
    letter-spacing: .16em !important;
    text-transform: uppercase !important;
    color: var(--color-acento) !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__sub{
    margin: 4px 0 0 !important;
    color: var(--color-parrafo) !important;
    font-size: var(--tamano-texto) !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__notas{
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__nota{
    margin: 0 !important;
    padding: 6px 14px !important;
    border: 1px solid var(--color-linea) !important;
    border-radius: 999px !important;
    font-size: var(--tamano-texto) !important;
    list-style: none !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__notas--serif .haru-pdp-pir__nota{
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    font-family: 'Instrument Serif', Georgia, serif !important;
    font-size: var(--tamano-nota) !important;
    line-height: 1.1 !important;
    letter-spacing: -.01em !important;
  }
  #shopify-section-{{ section.id }} .haru-pdp-pir__notas--serif .haru-pdp-pir__nota:not(:last-child)::after{
    content: "·" !important;
    margin-left: 8px !important;
    color: var(--color-acento) !important;
  }
  @media screen and (min-width: 750px){
    #shopify-section-{{ section.id }} .haru-pdp-pir{
      --tamano-titulo: {{ section.settings.tamano_titulo }}px !important;
      --tamano-texto: {{ section.settings.tamano_texto }}px !important;
      --tamano-nota: {{ section.settings.tamano_nota }}px !important;
      --tamano-etiqueta: {{ section.settings.tamano_etiqueta }}px !important;
      padding-top: {{ section.settings.padding_superior }}px !important;
      padding-bottom: {{ section.settings.padding_inferior }}px !important;
    }
    #shopify-section-{{ section.id }} .haru-pdp-pir__contenido{ padding-inline: 32px !important; }
    #shopify-section-{{ section.id }} .haru-pdp-pir__piramide{ margin-top: 56px !important; }
    #shopify-section-{{ section.id }} .haru-pdp-pir__fila{
      grid-template-columns: minmax(0, 240px) minmax(0, 1fr) !important;
      align-items: center !important;
      gap: 32px !important;
      padding: 32px !important;
    }
    #shopify-section-{{ section.id }} .haru-pdp-pir__fila--1{ width: 64% !important; }
    #shopify-section-{{ section.id }} .haru-pdp-pir__fila--2{ width: 82% !important; }
    #shopify-section-{{ section.id }} .haru-pdp-pir__fila--3{ width: 100% !important; }
  }
{%- endstyle -%}

<section class="haru-pdp-pir haru-pdp-pir-{{ section.id }}">
  <div class="haru-pdp-pir__contenido">
    {%- if section.settings.etiqueta != blank -%}
      <p class="haru-pdp-pir__etiqueta">{{ section.settings.etiqueta }}</p>
    {%- endif -%}
    <h2 class="haru-pdp-pir__titulo">{{ section.settings.titulo }}</h2>
    <ol class="haru-pdp-pir__piramide">
      {%- for i in (1..3) -%}
        {%- case i -%}
          {%- when 1 -%}
            {%- assign nivel = section.settings.nombre_salida -%}
            {%- assign sub = section.settings.sub_salida -%}
            {%- assign lista = n_salida | split: ',' -%}
          {%- when 2 -%}
            {%- assign nivel = section.settings.nombre_corazon -%}
            {%- assign sub = section.settings.sub_corazon -%}
            {%- assign lista = n_corazon | split: ',' -%}
          {%- else -%}
            {%- assign nivel = section.settings.nombre_fondo -%}
            {%- assign sub = section.settings.sub_fondo -%}
            {%- assign lista = n_fondo | split: ',' -%}
        {%- endcase -%}
        {%- if lista.size > 0 -%}
          <li class="haru-pdp-pir__fila haru-pdp-pir__fila--{{ i }}">
            <div>
              <h3 class="haru-pdp-pir__nivel">{{ nivel }}</h3>
              {%- if sub != blank -%}
                <p class="haru-pdp-pir__sub">{{ sub }}</p>
              {%- endif -%}
            </div>
            <ul class="haru-pdp-pir__notas{% if section.settings.estilo_notas == 'serif' %} haru-pdp-pir__notas--serif{% endif %}">
              {%- for nota in lista -%}
                {%- assign nota_limpia = nota | strip -%}
                {%- if nota_limpia != blank -%}
                  <li class="haru-pdp-pir__nota">{{ nota_limpia | escape | capitalize }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Haru PDP Pirámide",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta superior", "default": "Notas" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Pirámide olfativa" },
    { "type": "select", "id": "estilo_notas", "label": "Estilo de las notas", "default": "chips", "options": [
      { "value": "chips", "label": "Chips" },
      { "value": "serif", "label": "Texto serif grande" }
    ] },
    { "type": "text", "id": "nombre_salida", "label": "Nivel 1: nombre", "default": "Salida" },
    { "type": "text", "id": "sub_salida", "label": "Nivel 1: subtítulo", "default": "los primeros minutos" },
    { "type": "text", "id": "nombre_corazon", "label": "Nivel 2: nombre", "default": "Corazón" },
    { "type": "text", "id": "sub_corazon", "label": "Nivel 2: subtítulo", "default": "lo que se queda en la piel" },
    { "type": "text", "id": "nombre_fondo", "label": "Nivel 3: nombre", "default": "Fondo" },
    { "type": "text", "id": "sub_fondo", "label": "Nivel 3: subtítulo", "default": "la estela, horas después" },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_fondo", "label": "Fondo", "default": "#100e0b" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#f2ede4" },
    { "type": "color", "id": "color_parrafo", "label": "Texto secundario", "default": "#b89c78" },
    { "type": "color", "id": "color_acento", "label": "Acento", "default": "#b89c78" },
    { "type": "header", "content": "Tipografía" },
    { "type": "range", "id": "tamano_titulo", "label": "Tamaño del título (escritorio)", "min": 24, "max": 100, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "tamano_titulo_movil", "label": "Tamaño del título (móvil)", "min": 20, "max": 70, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "tamano_texto", "label": "Tamaño del texto (escritorio)", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "tamano_texto_movil", "label": "Tamaño del texto (móvil)", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "tamano_nota", "label": "Tamaño de notas serif (escritorio)", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "tamano_nota_movil", "label": "Tamaño de notas serif (móvil)", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "tamano_etiqueta", "label": "Tamaño de etiquetas (escritorio)", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "tamano_etiqueta_movil", "label": "Tamaño de etiquetas (móvil)", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_superior", "label": "Padding superior (escritorio)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_inferior", "label": "Padding inferior (escritorio)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_superior_movil", "label": "Padding superior (móvil)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_inferior_movil", "label": "Padding inferior (móvil)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "ancho_contenido", "label": "Ancho máximo del contenido", "min": 1000, "max": 1800, "step": 40, "unit": "px", "default": 1280 }
  ],
  "presets": [
    { "name": "Haru PDP Pirámide" }
  ]
}
{% endschema %}
