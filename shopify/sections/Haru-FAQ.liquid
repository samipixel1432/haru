{%- style -%}
  #shopify-section-{{ section.id }} .haru-faq{
    --ancho-contenido: {{ section.settings.ancho_contenido }}px !important;
    --color-fondo: {{ section.settings.color_fondo }} !important;
    --color-texto: {{ section.settings.color_texto }} !important;
    --color-acento: {{ section.settings.color_acento }} !important;
    --color-parrafo: {{ section.settings.color_parrafo }} !important;
    --color-linea: color-mix(in srgb, {{ section.settings.color_texto }} 14%, transparent) !important;
    --tamano-titulo: {{ section.settings.tamano_titulo_movil }}px !important;
    --tamano-pregunta: {{ section.settings.tamano_pregunta_movil }}px !important;
    --tamano-texto: {{ section.settings.tamano_texto_movil }}px !important;
    --tamano-etiqueta: {{ section.settings.tamano_etiqueta_movil }}px !important;
    box-sizing: border-box !important;
    display: block !important;
    scroll-margin-top: 96px !important;
    padding-top: {{ section.settings.padding_superior_movil }}px !important;
    padding-bottom: {{ section.settings.padding_inferior_movil }}px !important;
    background: var(--color-fondo) !important;
    color: var(--color-texto) !important;
    font-family: 'Hanken Grotesk', system-ui, sans-serif !important;
    font-size: var(--tamano-texto) !important;
    line-height: 1.6 !important;
  }
  #shopify-section-{{ section.id }} .haru-faq :where(h1,h2,h3,h4,h5,p,a,ul,ol,li,b,s,em,strong,span,small,summary,blockquote,figcaption){ color: inherit !important; font-family: inherit !important; }
  #shopify-section-{{ section.id }} .haru-faq *,
  #shopify-section-{{ section.id }} .haru-faq *::before,
  #shopify-section-{{ section.id }} .haru-faq *::after{
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__contenido{
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) !important;
    gap: 40px !important;
    max-width: var(--ancho-contenido) !important;
    margin-inline: auto !important;
    padding-inline: 20px !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__etiqueta{
    margin: 0 !important;
    font-family: 'IBM Plex Mono', ui-monospace, monospace !important;
    font-size: var(--tamano-etiqueta) !important;
    line-height: 1.4 !important;
    letter-spacing: .16em !important;
    text-transform: uppercase !important;
    color: var(--color-acento) !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__titulo{
    margin: 12px 0 0 !important;
    padding: 0 !important;
    font-family: 'Instrument Serif', Georgia, serif !important;
    font-size: var(--tamano-titulo) !important;
    font-weight: 400 !important;
    line-height: 1 !important;
    letter-spacing: -.01em !important;
    text-transform: none !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__lista{
    border-top: 1px solid var(--color-linea) !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__item{
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-bottom: 1px solid var(--color-linea) !important;
    background: transparent !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__resumen{
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 24px !important;
    min-height: 44px !important;
    padding: 20px 0 !important;
    list-style: none !important;
    text-align: left !important;
    cursor: pointer !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__resumen::-webkit-details-marker{ display: none !important; }
  #shopify-section-{{ section.id }} .haru-faq__resumen::marker{ content: "" !important; }
  #shopify-section-{{ section.id }} .haru-faq__resumen:focus-visible{
    outline: 2px solid var(--color-acento) !important;
    outline-offset: 3px !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__pregunta{
    font-family: 'Instrument Serif', Georgia, serif !important;
    font-size: var(--tamano-pregunta) !important;
    font-weight: 400 !important;
    line-height: 1.375 !important;
    letter-spacing: -.01em !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__mas{
    display: flex !important;
    flex: none !important;
    align-items: center !important;
    justify-content: center !important;
    width: 32px !important;
    height: 32px !important;
    font-family: 'IBM Plex Mono', ui-monospace, monospace !important;
    font-size: 18px !important;
    line-height: 1 !important;
    transition: transform .3s cubic-bezier(.22,1,.36,1) !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__mas::before{ content: "+" !important; }
  #shopify-section-{{ section.id }} .haru-faq__item[open] .haru-faq__mas{ transform: rotate(45deg) !important; }
  #shopify-section-{{ section.id }} .haru-faq__respuesta{
    max-width: 672px !important;
    padding-bottom: 24px !important;
    font-size: var(--tamano-texto) !important;
    line-height: 1.625 !important;
    color: var(--color-parrafo) !important;
  }
  #shopify-section-{{ section.id }} .haru-faq__respuesta p{ margin: 0 !important; }
  #shopify-section-{{ section.id }} .haru-faq__respuesta p + p{ margin-top: 12px !important; }
  @supports (animation-timeline: view()){
    #shopify-section-{{ section.id }} .haru-faq__reveal{
      animation: haru-faq-reveal linear both !important;
      animation-timeline: view() !important;
      animation-range: entry 5% entry 45% !important;
    }
  }
  @media screen and (min-width: 750px){
    #shopify-section-{{ section.id }} .haru-faq{
      --tamano-titulo: {{ section.settings.tamano_titulo }}px !important;
      --tamano-pregunta: {{ section.settings.tamano_pregunta }}px !important;
      --tamano-texto: {{ section.settings.tamano_texto }}px !important;
      --tamano-etiqueta: {{ section.settings.tamano_etiqueta }}px !important;
      padding-top: {{ section.settings.padding_superior }}px !important;
      padding-bottom: {{ section.settings.padding_inferior }}px !important;
    }
    #shopify-section-{{ section.id }} .haru-faq__contenido{
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) !important;
      gap: 80px !important;
      padding-inline: 32px !important;
    }
  }
  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ section.id }} .haru-faq__reveal{ animation: none !important; }
    #shopify-section-{{ section.id }} .haru-faq__mas{ transition-duration: .01ms !important; }
  }
  @keyframes haru-faq-reveal{
    from{ opacity: 0; transform: translateY(24px); }
    to{ opacity: 1; transform: none; }
  }
{%- endstyle -%}

<section class="haru-faq haru-faq-{{ section.id }}"{% if section.settings.id_ancla != blank %} id="{{ section.settings.id_ancla | handleize }}"{% endif %}>
  <div class="haru-faq__contenido">
    <div class="haru-faq__reveal">
      {%- if section.settings.etiqueta != blank -%}
        <p class="haru-faq__etiqueta">{{ section.settings.etiqueta }}</p>
      {%- endif -%}
      <h2 class="haru-faq__titulo">{{ section.settings.titulo }}</h2>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="haru-faq__lista haru-faq__reveal">
        {%- for block in section.blocks -%}
          <details class="haru-faq__item"{% if forloop.first and section.settings.primera_abierta %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="haru-faq__resumen">
              <span class="haru-faq__pregunta">{{ block.settings.pregunta }}</span>
              <span class="haru-faq__mas" aria-hidden="true"></span>
            </summary>
            <div class="haru-faq__respuesta">{{ block.settings.respuesta }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Haru FAQ",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta superior", "default": "Preguntas frecuentes" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Antes de pedir" },
    { "type": "text", "id": "id_ancla", "label": "Ancla de la sección", "default": "preguntas", "info": "Para enlazar con #preguntas" },
    { "type": "checkbox", "id": "primera_abierta", "label": "Primera pregunta abierta", "default": false },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_fondo", "label": "Fondo", "default": "#f2ede4" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#16130f" },
    { "type": "color", "id": "color_parrafo", "label": "Texto de las respuestas", "default": "#3a352d" },
    { "type": "color", "id": "color_acento", "label": "Acento", "default": "#7a5c3c" },
    { "type": "header", "content": "Tipografía" },
    { "type": "range", "id": "tamano_titulo", "label": "Tamaño del título (escritorio)", "min": 24, "max": 100, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "tamano_titulo_movil", "label": "Tamaño del título (móvil)", "min": 20, "max": 70, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "tamano_pregunta", "label": "Tamaño de la pregunta (escritorio)", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "tamano_pregunta_movil", "label": "Tamaño de la pregunta (móvil)", "min": 16, "max": 36, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "tamano_texto", "label": "Tamaño de la respuesta (escritorio)", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "tamano_texto_movil", "label": "Tamaño de la respuesta (móvil)", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "tamano_etiqueta", "label": "Tamaño de la etiqueta (escritorio)", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "tamano_etiqueta_movil", "label": "Tamaño de la etiqueta (móvil)", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_superior", "label": "Padding superior (escritorio)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 144 },
    { "type": "range", "id": "padding_inferior", "label": "Padding inferior (escritorio)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_superior_movil", "label": "Padding superior (móvil)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_inferior_movil", "label": "Padding inferior (móvil)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "ancho_contenido", "label": "Ancho máximo del contenido", "min": 1000, "max": 1800, "step": 40, "unit": "px", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "pregunta", "label": "Pregunta", "default": "¿Cómo hago mi pedido?" },
        { "type": "richtext", "id": "respuesta", "label": "Respuesta", "default": "<p>Agrega lo que quieras al carrito y toca “Enviar pedido por WhatsApp”. Te llega un mensaje ya armado con cada producto, su foto y el total; solo lo envías y te respondemos.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Haru FAQ",
      "blocks": [
        { "type": "pregunta", "settings": { "pregunta": "¿Cómo hago mi pedido?", "respuesta": "<p>Agrega lo que quieras al carrito y toca “Enviar pedido por WhatsApp”. Te llega un mensaje ya armado con cada producto, su foto y el total; solo lo envías y te respondemos.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Cómo se paga?", "respuesta": "<p>El medio de pago lo acordamos contigo por WhatsApp una vez confirmamos disponibilidad. No se te cobra nada al armar el pedido.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Hacen envíos?", "respuesta": "<p>Sí, coordinamos el envío contigo por WhatsApp según tu ciudad. Escríbenos y te decimos tiempos y costo antes de que pagues.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "No sé qué aroma elegir", "respuesta": "<p>Haz el test “Encuentra tu aroma” (1 minuto) o escríbenos contándonos qué te gusta: te recomendamos opciones según tu estilo y presupuesto.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Puedo cambiar o consultar un producto antes de comprarlo?", "respuesta": "<p>Claro. Antes de pagar puedes preguntarnos lo que quieras sobre un producto: notas, duración, tamaño o disponibilidad.</p>" } }
      ]
    }
  ]
}
{% endschema %}
